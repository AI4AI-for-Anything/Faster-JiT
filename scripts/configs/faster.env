# Faster-JiT: environment switches of the measured configuration (round R53, commit 19b7549, full check 1.5618x).
# Every JIT_* switch is off unless set; with none set the code runs the upstream path.
# Model-side values match .harness/config.json and optimizations/flex_pointwise_tune.json.
# The additional input cache requires CROP_CACHE_PATH and a full verification receipt.
# Usage: source scripts/configs/faster.env
export JIT_SDPA_BACKEND=flex                 # FlexAttention for dense BF16 zero-dropout attention (Q/K cast to BF16)
export JIT_COMPILE_MODEL=1                   # torch.compile the whole JiT.forward ...
export JIT_COMPILE_MODE=reduce-overhead      # ... with CUDA graphs
export JIT_FUSED_QK_PREP=1                   # Triton QK RMSNorm + RoPE + head layout, fixed-order backward
export JIT_COMPILE_EMA=0                     # keep 0: the compiled EMA path failed the revised EMA check
export JIT_COMPILE_EMA_MODE=reduce-overhead  # unused while JIT_COMPILE_EMA=0 (kept as measured)
export JIT_BF16_CONTEXT=1                    # cast in-context tokens to BF16 before concatenation
export JIT_FUSED_ADAMW=1                     # torch.optim.AdamW(fused=True), FP32 master weights and moments
export JIT_FOREACH_EMA=1                     # both EMAs with torch._foreach_mul_/_foreach_add_
export JIT_CONTIGUOUS_EARLY_RESIDUAL=1       # contiguous residual stream after patch + position embedding
export JIT_SWIGLU_BIAS_FUSION=1              # Triton SwiGLU with fused w12 bias-gradient partials
export JIT_COMPILE_DENOISER=1                # compile the outer Denoiser.forward; Inductor fallback_random
export TORCHINDUCTOR_MAX_AUTOTUNE_POINTWISE=1   # stock Inductor tuning of pointwise/reduction kernels
export TORCHINDUCTOR_COORDINATE_DESCENT_TUNING=1
export TORCH_LOGS=+inductor                  # logging only; it was set in the measured run to record tuning choices
export JIT_CROP_CACHE=1                     # verified reference center crops; set CROP_CACHE_PATH (see docs/training.md)
